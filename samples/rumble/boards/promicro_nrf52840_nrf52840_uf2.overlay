/*
 * Copyright (c) 2026 the OpenSC2-Controller authors
 * SPDX-License-Identifier: MIT
 *
 * SuperMini / Pro Micro nRF52840 with a vibration motor (ERM) driven by a PWM output. Never drive
 * a motor straight from the pin: use a logic-level MOSFET (gate on P0.22, motor between VCC or
 * BAT+ and the drain, a flyback diode across the motor) or a ready-made MOSFET module. (An LRA
 * needs a driver chip set up over I2C, which this sample does not do: see README.md.)
 *
 *   P0.22 PWM to the MOSFET gate or driver input    P0.31 pairing button (to GND)
 */
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <dt-bindings/opensc2/inputs.h>

/ {
	opensc2_buttons: opensc2_buttons {
		compatible = "gpio-keys";
		debounce-interval-ms = <5>;
		/* Held while plugging in: this boot is wireless. Pressed and released while wired:
		 * back to wireless mode. Pressed while wireless: answers an open pairing window. */
		opensc2_pair: pair {
			gpios = <&gpio0 31 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <OPENSC2_KEY_PAIR>;
		};
	};

	zephyr,user {
		/* 5 kHz: above what a motor reacts to, low enough for any MOSFET. The firmware finds
		 * the channel by its name. */
		pwms = <&pwm1 0 PWM_USEC(200) PWM_POLARITY_NORMAL>;
		pwm-names = "rumble";
		/* nice!nano-style boards switch VCC with P0.13 (low = on); check yours. */
		vcc-enable-gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
	};

	/* Wired mode: the USB HID function of the wired Steam Controller 2 (64-byte reports, 1 ms),
	 * and 16 KB of RAM that a soft reset keeps (the warm-restart mark, the USB session log), clear
	 * of the RAM the UF2 bootloader uses at every reset (docs/porting.md). */
	chosen {
		opensc2,usb-hid = &opensc2_hid;
		opensc2,retained-ram = &opensc2_retained;
	};

	opensc2_hid: opensc2_hid {
		compatible = "zephyr,hid-device";
		in-report-size = <64>;
		in-polling-period-us = <1000>;
		out-report-size = <64>;
		out-polling-period-us = <1000>;
	};

	opensc2_retained: memory@2002c000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x2002c000 DT_SIZE_K(16)>;
		zephyr,memory-region = "OPENSC2_RETAINED";
	};
};

/* The application's RAM ends below the retained area (176 KB of the 256). */
&sram0 {
	reg = <0x20000000 DT_SIZE_K(176)>;
};

/* The PWM output on P0.22. Any free pin works: the nRF52840 routes PWM to any GPIO. */
&pinctrl {
	pwm1_motor_default: pwm1_motor_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 22)>;
		};
	};
	pwm1_motor_sleep: pwm1_motor_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 22)>;
			low-power-enable;
		};
	};
};

&pwm1 {
	status = "okay";
	pinctrl-0 = <&pwm1_motor_default>;
	pinctrl-1 = <&pwm1_motor_sleep>;
	pinctrl-names = "default", "sleep";
};
