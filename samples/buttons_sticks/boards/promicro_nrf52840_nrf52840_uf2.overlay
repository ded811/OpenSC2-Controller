/*
 * SuperMini / Pro Micro nRF52840: five buttons, a pairing button, one analog stick and one analog
 * trigger. Buttons between pin and GND; potentiometers between VCC and GND, wiper to the pin.
 *
 *   P1.15 A    P1.13 B    P1.11 X    P0.10 Y    P1.04 STEAM    P0.09 pairing
 *   P0.02 (AIN0) left stick X    P0.29 (AIN5) left stick Y    P0.31 (AIN7) right trigger
 */
#include <dt-bindings/opensc2/inputs.h>

#define BUTTON(port, pin) <&gpio##port pin (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>

/ {
	buttons: buttons {
		compatible = "gpio-keys";
		debounce-interval-ms = <5>;
		a     { gpios = BUTTON(1, 15); zephyr,code = <OPENSC2_KEY_A>; };
		b     { gpios = BUTTON(1, 13); zephyr,code = <OPENSC2_KEY_B>; };
		x     { gpios = BUTTON(1, 11); zephyr,code = <OPENSC2_KEY_X>; };
		y     { gpios = BUTTON(0, 10); zephyr,code = <OPENSC2_KEY_Y>; };
		steam { gpios = BUTTON(1, 4);  zephyr,code = <OPENSC2_KEY_STEAM>; };
		pair  { gpios = BUTTON(0, 9);  zephyr,code = <OPENSC2_KEY_PAIR>; };
	};

	zephyr,user {
		io-channels = <&adc 0>, <&adc 1>, <&adc 2>;
		io-channel-names = "stick-x", "stick-y", "trigger";
		/* nice!nano-style boards switch VCC with P0.13 (low = on); check yours. */
		vcc-enable-gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
	};
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_VDD_1_4";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 10)>;
		zephyr,input-positive = <NRF_SAADC_AIN0>;
		zephyr,resolution = <12>;
	};
	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_VDD_1_4";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 10)>;
		zephyr,input-positive = <NRF_SAADC_AIN5>;
		zephyr,resolution = <12>;
	};
	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_VDD_1_4";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 10)>;
		zephyr,input-positive = <NRF_SAADC_AIN7>;
		zephyr,resolution = <12>;
	};
};

/* Peripherals of the board on pins used above. */
&i2c1 { status = "disabled"; };
&uart0 { status = "disabled"; };
