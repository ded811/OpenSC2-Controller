/*
 * SuperMini / Pro Micro nRF52840 with an MPU-6050 module (GY-521 breakout) on I2C as the IMU.
 * Any accelerometer and gyroscope with a Zephyr sensor driver works the same way (LSM6DSO,
 * ICM42688, ...): replace the node and keep the `imu` label.
 *
 *   P0.17 SDA    P0.20 SCL    VCC, GND    P0.31 pairing button (to GND)
 */
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <dt-bindings/opensc2/inputs.h>

/ {
	buttons: buttons {
		compatible = "gpio-keys";
		debounce-interval-ms = <5>;
		pair {
			gpios = <&gpio0 31 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <OPENSC2_KEY_PAIR>;
		};
	};

	zephyr,user {
		/* nice!nano-style boards switch VCC with P0.13 (low = on); check yours. */
		vcc-enable-gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
	};
};

&pinctrl {
	i2c0_imu_default: i2c0_imu_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 17)>, <NRF_PSEL(TWIM_SCL, 0, 20)>;
		};
	};
	i2c0_imu_sleep: i2c0_imu_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 17)>, <NRF_PSEL(TWIM_SCL, 0, 20)>;
			low-power-enable;
		};
	};
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_imu_default>;
	pinctrl-1 = <&i2c0_imu_sleep>;
	pinctrl-names = "default", "sleep";

	imu: mpu6050@68 {
		compatible = "invensense,mpu6050";
		reg = <0x68>;
		/* The ranges of the controller's report: +-2 g and +-2000 deg/s. */
		accel-fs = <2>;
		gyro-fs = <2000>;
	};
};

&uart0 { status = "disabled"; };
