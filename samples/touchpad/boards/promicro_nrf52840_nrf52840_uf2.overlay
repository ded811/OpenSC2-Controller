/*
 * SuperMini / Pro Micro nRF52840 with a Cirque Pinnacle trackpad module (for example the TM040040
 * or TM035035 on its I2C interface) as the controller's right trackpad. Zephyr's own
 * cirque,pinnacle driver reads it.
 *
 *   P0.17 SDA    P0.20 SCL    P0.22 the module's data-ready (HW_DR) output    VCC, GND
 *   P1.15 pad click button (to GND)    P0.31 pairing button (to GND)
 *
 * Any other touch device of Zephyr's input subsystem works the same way: point the `touch` label
 * at it and set its coordinate range in zephyr,user.
 */
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <dt-bindings/opensc2/inputs.h>

/ {
	buttons: buttons {
		compatible = "gpio-keys";
		debounce-interval-ms = <5>;
		pad_click {
			gpios = <&gpio1 15 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <OPENSC2_KEY_RIGHT_PAD_CLICK>;
		};
		pair {
			gpios = <&gpio0 31 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <OPENSC2_KEY_PAIR>;
		};
	};

	zephyr,user {
		/* The coordinate range the touch device reports (the Pinnacle is scaled to this). */
		trackpad-size = <1024 1024>;
		/* nice!nano-style boards switch VCC with P0.13 (low = on); check yours. */
		vcc-enable-gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
	};
};

&pinctrl {
	i2c0_touch_default: i2c0_touch_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 17)>, <NRF_PSEL(TWIM_SCL, 0, 20)>;
		};
	};
	i2c0_touch_sleep: i2c0_touch_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 17)>, <NRF_PSEL(TWIM_SCL, 0, 20)>;
			low-power-enable;
		};
	};
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_touch_default>;
	pinctrl-1 = <&i2c0_touch_sleep>;
	pinctrl-names = "default", "sleep";

	touch: trackpad@2a {
		compatible = "cirque,pinnacle";
		reg = <0x2a>;
		data-ready-gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>;
		data-mode = "absolute";
		/* One empty packet after the finger lifts, so the pad sees the release. */
		idle-packets-count = <1>;
		clipping-enable;
		scaling-enable;
		scaling-x-resolution = <1024>;
		scaling-y-resolution = <1024>;
	};
};

/* Peripherals of the board on pins used above. */
&uart0 { status = "disabled"; };
&i2c1 { status = "disabled"; };
