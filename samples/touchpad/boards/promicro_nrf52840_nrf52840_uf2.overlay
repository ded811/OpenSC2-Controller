/*
 * Copyright (c) 2026 the OpenSC2-Controller authors
 * SPDX-License-Identifier: MIT
 *
 * SuperMini / Pro Micro nRF52840 with a Cirque Pinnacle trackpad module (for example the TM040040
 * or TM035035, on its I2C interface) as the controller's right trackpad. Zephyr's own
 * cirque,pinnacle driver reads it.
 *
 *   P0.17 SDA    P0.20 SCL    P0.22 the module's data-ready (HW_DR) output    VCC, GND
 *   P1.15 pad click button (to GND)    P0.31 pairing button (to GND)
 *
 * Any other touch device of Zephyr's input subsystem works the same way: point the `touch` label
 * at it and set its coordinate range in zephyr,user.
 */
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <dt-bindings/opensc2/inputs.h>

/ {
	/* zephyr,code is the bit of the Steam Controller 2 button word (dt-bindings/opensc2/inputs.h);
	 * OPENSC2_KEY_PAIR marks the pairing button. */
	opensc2_buttons: opensc2_buttons {
		compatible = "gpio-keys";
		debounce-interval-ms = <5>;
		pad_click {
			gpios = <&gpio1 15 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <OPENSC2_KEY_RIGHT_PAD_CLICK>;
		};
		/* Held while plugging in: this boot is wireless. Pressed and released while wired:
		 * back to wireless mode. Pressed while wireless: answers an open pairing window. */
		opensc2_pair: pair {
			gpios = <&gpio0 31 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <OPENSC2_KEY_PAIR>;
		};
	};

	zephyr,user {
		/* The coordinate range the touch device reports (the Pinnacle is scaled to this). */
		trackpad-size = <1024 1024>;
		/* nice!nano-style boards switch VCC with P0.13 (low = on); check yours. */
		vcc-enable-gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
	};

	/* Wired mode: the USB HID function of the wired Steam Controller 2 (64-byte reports, 1 ms),
	 * and 16 KB of RAM that a soft reset keeps (the warm-restart mark, the USB session log), clear
	 * of the RAM the UF2 bootloader uses at every reset (docs/porting.md). */
	chosen {
		opensc2,usb-hid = &opensc2_hid;
		opensc2,retained-ram = &opensc2_retained;
	};

	opensc2_hid: opensc2_hid {
		compatible = "zephyr,hid-device";
		in-report-size = <64>;
		in-polling-period-us = <1000>;
		out-report-size = <64>;
		out-polling-period-us = <1000>;
	};

	opensc2_retained: memory@2002c000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x2002c000 DT_SIZE_K(16)>;
		zephyr,memory-region = "OPENSC2_RETAINED";
	};
};

/* The application's RAM ends below the retained area (176 KB of the 256). */
&sram0 {
	reg = <0x20000000 DT_SIZE_K(176)>;
};

/* The board's first I2C bus, moved to P0.17 and P0.20. */
&pinctrl {
	i2c0_touch_default: i2c0_touch_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 17)>, <NRF_PSEL(TWIM_SCL, 0, 20)>;
		};
	};
	i2c0_touch_sleep: i2c0_touch_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 17)>, <NRF_PSEL(TWIM_SCL, 0, 20)>;
			low-power-enable;
		};
	};
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_touch_default>;
	pinctrl-1 = <&i2c0_touch_sleep>;
	pinctrl-names = "default", "sleep";

	touch: trackpad@2a {
		compatible = "cirque,pinnacle";
		reg = <0x2a>;
		/* HW_DR goes high when a new sample is ready; the driver reads on that edge. */
		data-ready-gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>;
		data-mode = "absolute";
		/* One empty packet after the finger lifts, so the pad sees the release. */
		idle-packets-count = <1>;
		clipping-enable;
		scaling-enable;
		scaling-x-resolution = <1024>;
		scaling-y-resolution = <1024>;
	};
};

/* Not used here: the board's UART and its second I2C bus. The log and the shell are on the USB
 * serial port. */
&uart0 { status = "disabled"; };
&i2c1 { status = "disabled"; };
