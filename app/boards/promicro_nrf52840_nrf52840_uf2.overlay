/*
 * Copyright (c) 2026 the OpenSC2-Controller authors
 * SPDX-License-Identifier: MIT
 *
 * OpenSC2 "blank canvas" for the SuperMini / Pro Micro nRF52840 (nice!nano pinout, Adafruit UF2
 * bootloader). EVERY input of the controller is set up in this one file.
 *
 *  - Buttons: wire each between its pin and GND. The internal pull-up holds it released.
 *  - Sticks: a potentiometer per axis, ends to VCC and GND, wiper to the pin.
 *  - Anything you do not wire reads neutral: buttons released, sticks centred, triggers released.
 *    Analog pins that are listed but not wired are held at mid-scale (sticks) or at ground
 *    (triggers) by the chip's own bias resistors, so they never drift.
 *  - To move an input, change its pin. To drop one, delete its node (or its io-channel name).
 *
 * The SuperMini brings out 21 usable pins, and only three of them (P0.02, P0.29, P0.31) can be
 * analog. This default spends them on every main button, digital triggers, the left stick and a
 * pairing button. The right stick, analog triggers and the four back buttons (L4, L5, R4, R5) are
 * listed at the bottom, ready to enable on a board with more pins. Pin labels on the SuperMini's
 * silkscreen: "006" is P0.06, "111" is P1.11, and so on.
 *
 *   Left edge (USB at the top)        Right edge                     Bottom pads
 *   P0.06  D-pad up                   P0.31  pairing button          P1.01  RT (digital)
 *   P0.08  D-pad down                 P0.29  left stick Y (AIN5)     P1.02  R3 (right stick click)
 *   P0.17  D-pad left                 P0.02  left stick X (AIN0)     P1.07  VIEW
 *   P0.20  D-pad right                P1.15  A
 *   P0.22  L (left bumper)            P1.13  B
 *   P0.24  LT (digital)               P1.11  X
 *   P1.00  L3 (left stick click)      P0.10  Y
 *   P0.11  MENU                       P0.09  R (right bumper)
 *   P1.04  STEAM
 *   P1.06  QAM (quick access, "...")
 *
 *   On-board LED (P0.15): link and USB status.
 *
 * Wired mode (bottom of the root node): the USB HID function and the retained RAM area.
 */
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/opensc2/inputs.h>

#define BUTTON(port, pin) <&gpio##port pin (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>

/ {
	/* ---- Buttons ---------------------------------------------------------------------------
	 * zephyr,code is the bit of the Steam Controller 2 button word (dt-bindings/opensc2/inputs.h).
	 * Two codes are special: OPENSC2_KEY_LEFT/RIGHT_TRIGGER_CLICK on a button make that trigger a
	 * digital one (pressed = fully pulled), and OPENSC2_KEY_PAIR is the pairing button.
	 */
	opensc2_buttons: opensc2_buttons {
		compatible = "gpio-keys";
		/* The real controller counts a change at once and then holds the pin for 16 ms;
		 * gpio-keys waits until a contact has been steady this long instead. 16 gives the
		 * real controller's interval, with presses reported up to 16 ms later. */
		debounce-interval-ms = <5>;

		dpad_up    { gpios = BUTTON(0, 6);  zephyr,code = <OPENSC2_KEY_DPAD_UP>; };
		dpad_down  { gpios = BUTTON(0, 8);  zephyr,code = <OPENSC2_KEY_DPAD_DOWN>; };
		dpad_left  { gpios = BUTTON(0, 17); zephyr,code = <OPENSC2_KEY_DPAD_LEFT>; };
		dpad_right { gpios = BUTTON(0, 20); zephyr,code = <OPENSC2_KEY_DPAD_RIGHT>; };
		bumper_l   { gpios = BUTTON(0, 22); zephyr,code = <OPENSC2_KEY_L>; };
		trigger_l  { gpios = BUTTON(0, 24); zephyr,code = <OPENSC2_KEY_LEFT_TRIGGER_CLICK>; };
		stick_l    { gpios = BUTTON(1, 0);  zephyr,code = <OPENSC2_KEY_L3>; };
		menu       { gpios = BUTTON(0, 11); zephyr,code = <OPENSC2_KEY_MENU>; };
		steam      { gpios = BUTTON(1, 4);  zephyr,code = <OPENSC2_KEY_STEAM>; };
		qam        { gpios = BUTTON(1, 6);  zephyr,code = <OPENSC2_KEY_QAM>; };

		/* Held while powering up: this boot is wireless even on USB power. While wired:
		 * pressed before a host configures the board, or held 3 s (the LED goes dark), back
		 * to wireless when released. */
		opensc2_pair: pair { gpios = BUTTON(0, 31); zephyr,code = <OPENSC2_KEY_PAIR>; };
		button_a   { gpios = BUTTON(1, 15); zephyr,code = <OPENSC2_KEY_A>; };
		button_b   { gpios = BUTTON(1, 13); zephyr,code = <OPENSC2_KEY_B>; };
		button_x   { gpios = BUTTON(1, 11); zephyr,code = <OPENSC2_KEY_X>; };
		button_y   { gpios = BUTTON(0, 10); zephyr,code = <OPENSC2_KEY_Y>; };
		bumper_r   { gpios = BUTTON(0, 9);  zephyr,code = <OPENSC2_KEY_R>; };

		trigger_r  { gpios = BUTTON(1, 1);  zephyr,code = <OPENSC2_KEY_RIGHT_TRIGGER_CLICK>; };
		stick_r    { gpios = BUTTON(1, 2);  zephyr,code = <OPENSC2_KEY_R3>; };
		view       { gpios = BUTTON(1, 7);  zephyr,code = <OPENSC2_KEY_VIEW>; };

		/* No pins left on the SuperMini for these. Give them pins to use them:
		 * grip_l4 { gpios = BUTTON(x, y); zephyr,code = <OPENSC2_KEY_L4>; };
		 * grip_l5 { gpios = BUTTON(x, y); zephyr,code = <OPENSC2_KEY_L5>; };
		 * grip_r4 { gpios = BUTTON(x, y); zephyr,code = <OPENSC2_KEY_R4>; };
		 * grip_r5 { gpios = BUTTON(x, y); zephyr,code = <OPENSC2_KEY_R5>; };
		 * Touch bits work the same way, e.g. a capacitive grip sensor's digital output:
		 * grip_touch_l { gpios = <...>; zephyr,code = <OPENSC2_KEY_LEFT_GRIP_TOUCH>; };
		 */
	};

	zephyr,user {
		/* ---- Sticks and analog triggers ----------------------------------------------------
		 * Each axis is an ADC channel (defined below) with one of these names:
		 *   left-stick-x, left-stick-y, right-stick-x, right-stick-y, left-trigger, right-trigger
		 * A name that is not listed reads neutral. A trigger with an analog channel ignores
		 * its digital button above.
		 */
		io-channels = <&adc 0>, <&adc 1>;
		io-channel-names = "left-stick-x", "left-stick-y";

		/* Up must be positive: flip an axis that comes out the wrong way round. */
		/* invert-left-stick-x; */
		/* invert-left-stick-y; */
		/* invert-right-stick-x; */
		/* invert-right-stick-y; */
		/* invert-left-trigger; */
		/* invert-right-trigger; */

		/* Centre dead zone of the sticks, percent of the half range. */
		stick-deadzone-percent = <6>;

		/* nice!nano-style boards switch their VCC pin with P0.13 (low = on). The firmware
		 * turns VCC on at boot so potentiometers powered from VCC work. Check your board;
		 * delete this line if your VCC is always on or switched differently. */
		vcc-enable-gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;

		/* ---- Optional outputs (take their pins from buttons above) ----------------------
		 * A vibration motor ("rumble", samples/rumble), an RGB status LED in the real
		 * controller's colours ("red", "green", "blue", and "white" for an RGBW LED; wiring:
		 * samples/rgb_led) and an IR LED ("ir", controller setting 36) are PWM channels in a
		 * single pwms list, found by pwm-names. All channels of one nRF PWM instance share
		 * one period, so the motor (200 us) and the LED (1000 us) take two instances:
		 *   pwms = <&pwm1 0 PWM_USEC(200) PWM_POLARITY_NORMAL>,
		 *          <&pwm2 0 PWM_USEC(1000) PWM_POLARITY_INVERTED>,
		 *          <&pwm2 1 PWM_USEC(1000) PWM_POLARITY_INVERTED>,
		 *          <&pwm2 2 PWM_USEC(1000) PWM_POLARITY_INVERTED>;
		 *   pwm-names = "rumble", "red", "green", "blue";
		 * and enable &pwm1 and &pwm2 with a pinctrl group each (samples/rumble, rgb_led).
		 * The LED channels' trims, percent R G B W (the real controller's when not set):
		 *   led-trims = <90 35 120 80>;
		 * A charger module's status output (TP4056-style CHRG, active while charging) gives
		 * report 0x43 its charge state (src/battery.c; untested):
		 *   charger-status-gpios = <&gpio0 x (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		 * A mode switch to GND, closed at power-up: wireless, as if pairing were held:
		 *   mode-wireless-gpios = <&gpio0 x (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; */
	};

	/* ---- Optional trackpads and IMU (samples/touchpad, samples/imu) -----------------------
	 *   chosen { opensc2,right-trackpad = &touch; opensc2,left-trackpad = &touch2; };
	 *   aliases { imu0 = &imu; };   (the label of samples/imu's node, imu: mpu6050@68)
	 * and in zephyr,user each pad's coordinate range (1024 x 1024 when not set). Touch devices
	 * count Y from the top, the controller up from the bottom: Y is flipped, unless keep-y:
	 *   right-trackpad-size = <1024 1024>;   right-trackpad-keep-y;
	 *   left-trackpad-size = <1024 1024>;    left-trackpad-keep-y;
	 * A pad click is a button above with OPENSC2_KEY_RIGHT_PAD_CLICK or _LEFT_PAD_CLICK. */

	/* ---- Wired mode: the USB HID function of the wired Steam Controller 2: interrupt IN and
	 * OUT of 64 bytes, polled every 1 ms, no boot protocol, as on the real controller. */
	chosen {
		opensc2,usb-hid = &opensc2_hid;
		opensc2,retained-ram = &opensc2_retained;
	};

	opensc2_hid: opensc2_hid {
		compatible = "zephyr,hid-device";
		in-report-size = <64>;
		in-polling-period-us = <1000>;
		out-report-size = <64>;
		out-polling-period-us = <1000>;
	};

	/* 16 KB of RAM that start-up does not clear, for the USB session log and the warm-restart
	 * mark (Steam's "reboot into wireless mode"). They survive a soft reset. The UF2 bootloader
	 * runs at every reset and uses RAM from 0x20000000 to the end of its .bss (0x2000CE2C in
	 * 0.6.0, 0x2000DEC0 in 0.11.0) and its stack at 0x2003E000..0x20040000 (docs/porting.md):
	 * this region is clear of both. Keep it so if you move it. */
	opensc2_retained: memory@2002c000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x2002c000 DT_SIZE_K(16)>;
		zephyr,memory-region = "OPENSC2_RETAINED";
	};
};

/* The application's RAM ends below the retained area (176 KB of the 256; the top 64 KB stay
 * unused). */
&sram0 {
	reg = <0x20000000 DT_SIZE_K(176)>;
};

/* The analog inputs: gain 1/4 of VDD/4, so full scale is VDD, ratiometric with potentiometers
 * powered from VCC. Channel numbers are arbitrary; the AIN number picks the pin:
 *   AIN0 = P0.02, AIN5 = P0.29, AIN7 = P0.31 on the SuperMini's edge
 *   (AIN1 = P0.03, AIN2 = P0.04, AIN3 = P0.05, AIN4 = P0.28, AIN6 = P0.30 on other boards). */
&adc {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_VDD_1_4";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 10)>;
		zephyr,input-positive = <NRF_SAADC_AIN0>;   /* P0.02: left stick X */
		zephyr,resolution = <12>;
	};

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_VDD_1_4";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 10)>;
		zephyr,input-positive = <NRF_SAADC_AIN5>;   /* P0.29: left stick Y */
		zephyr,resolution = <12>;
	};

	/* On a board with more analog pins, add channels and names above, e.g.:
	 * channel@2 { reg = <2>; ... zephyr,input-positive = <NRF_SAADC_AIN7>; };  right-stick-x
	 * channel@3 { reg = <3>; ... zephyr,input-positive = <NRF_SAADC_AIN4>; };  right-stick-y
	 * channel@4 { reg = <4>; ... zephyr,input-positive = <NRF_SAADC_AIN6>; };  left-trigger
	 * channel@5 { reg = <5>; ... zephyr,input-positive = <NRF_SAADC_AIN1>; };  right-trigger
	 */
};

/* The board's other peripherals sit on pins the buttons use: switch them off. The log and the
 * shell are on the USB serial port (in wireless mode). */
&uart0 { status = "disabled"; };
&i2c0 { status = "disabled"; };
&i2c1 { status = "disabled"; };
&spi2 { status = "disabled"; };
&pwm0 { status = "disabled"; };

/* Button edges through the GPIO sense mechanism instead of GPIOTE channels: the nRF52840 has only
 * eight GPIOTE channels, fewer than the buttons above, and gpio-keys fails on the ninth (-ENOMEM).
 * Sense detection has no such limit. */
&gpio0 { sense-edge-mask = <0xffffffff>; };
&gpio1 { sense-edge-mask = <0xffff>; };
